# Base URL of apps/api, without /trpc. Only the server reads it.
# Optional in dev (defaults to http://127.0.0.1:3000), required in production.
API_URL=http://127.0.0.1:3000

# Production server only (pnpm start). Dev uses Vite's port.
PORT=3001
HOST=127.0.0.1
# Public origin of the site. Qwik Router checks form posts against it (CSRF).
ORIGIN=http://localhost:3001

# pnpm i18n:translate only, run by a developer. Never set these in the deploy pipeline.
# TRANSLATE_MODEL defaults to claude-opus-5-5.
TRANSLATE_API_KEY=
TRANSLATE_MODEL=
