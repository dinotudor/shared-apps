{
  "name": "@shared-apps/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode ssr",
    "build": "vite build && vite build -c adapters/node-server/vite.config.ts",
    "preview": "vite build && vite build --ssr src/entry.preview.tsx && vite preview",
    "start": "node server/entry.node-server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@qwik.dev/core": "catalog:",
    "@qwik.dev/router": "2.0.0-rc.5",
    "@shared-apps/design-system": "workspace:*",
    "@trpc/client": "catalog:"
  },
  "devDependencies": {
    "@shared-apps/api": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
