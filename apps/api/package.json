{
  "name": "@shared-apps/api",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "members:add": "node --env-file-if-exists=.env src/add-members.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shared-apps/auth": "workspace:*",
    "@shared-apps/api-core": "workspace:*",
    "@shared-apps/db": "workspace:*",
    "@shared-apps/jobs": "workspace:*",
    "@shared-apps/dishes": "workspace:*",
    "@shared-apps/membership": "workspace:*",
    "@trpc/server": "catalog:",
    "fastify": "^5.12.8",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "drizzle-orm": "catalog:"
  }
}
