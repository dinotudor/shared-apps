# Optional unless marked required; defaults shown.
PORT=3000
# Containers need 0.0.0.0 to accept outside connections.
HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Required. Matches the local database from `docker compose up` (compose.yaml).
DATABASE_URL=postgres://shared_apps:shared_apps@127.0.0.1:5433/shared_apps

# --- Sign-in (Better Auth with Google, docs/adr/0005) ---
# Required. Signs session cookies, at least 32 characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Required. Public URL of this API. Google redirects to <it>/api/auth/callback/google,
# so that URL must be listed in the Google OAuth client.
BETTER_AUTH_URL=http://localhost:3000
# Required. From the Google OAuth client (Google Cloud console → Credentials).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Required. Comma-separated emails that may sign in. Everyone else is refused.
AUTH_ALLOWED_EMAILS=person-one@example.com,person-two@example.com
# Required. Comma-separated origins of the frontends (scheme, host, port; no path).
# In dev, open the app at localhost, not 127.0.0.1: the session cookie is set for localhost.
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Production only: the parent domain shared by the API and the frontends, so they share
# the session cookie (api.example.com and dinner.example.com → example.com). Leave unset in dev.
# AUTH_COOKIE_DOMAIN=example.com
