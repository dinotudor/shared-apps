{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "postUpdateOptions": ["pnpmDedupe"],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Qwik 2 packages share one release-candidate version (ADR 0011): update them in one PR, never automerged.",
      "matchPackageNames": ["@qwik.dev/**", "eslint-plugin-qwik"],
      "groupName": "qwik",
      "automerge": false
    }
  ]
}
