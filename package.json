{
  "name": "shared-apps",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:wfdinner": "pnpm --parallel --filter @shared-apps/api --filter @shared-apps/whats-for-dinner dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:deps": "node scripts/check-dependency-sources.mjs",
    "test:ui": "vitest --ui",
    "db:generate": "pnpm --filter @shared-apps/db generate",
    "db:migrate": "pnpm --filter @shared-apps/api db:migrate"
  },
  "packageManager": "pnpm@12.19.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.19.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/ui": "catalog:",
    "eslint": "^10.14.0",
    "eslint-plugin-qwik": "2.0.0-rc.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "catalog:"
  }
}
